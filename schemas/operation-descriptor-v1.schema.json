{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:civic-orchestrator:schema:operation-descriptor:v1",
  "title":"Civic Operation Descriptor v1",
  "type":"object",
  "additionalProperties":false,
  "required":["operation","implementation","side_effect_class"],
  "properties":{
    "operation":{"$ref":"common-v1.schema.json#/$defs/operation"},
    "implementation":{"type":"string","enum":["stub","available","unavailable","disabled"]},
    "side_effect_class":{"type":"string","enum":["none","bounded"]},
    "requires_authorization":{"type":"boolean","default":true},
    "service_capability":{"$ref":"common-v1.schema.json#/$defs/id"}
  }
}
