{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:civic-orchestrator:schema:service-capability:v1",
  "title":"Civic Service Capability Advertisement v1",
  "type":"object",
  "additionalProperties":false,
  "required":["service_id","capability","status","contract_version"],
  "properties":{
    "service_id":{"$ref":"common-v1.schema.json#/$defs/id"},
    "capability":{"$ref":"common-v1.schema.json#/$defs/operation"},
    "status":{"type":"string","enum":["stub","available","unavailable","disabled"]},
    "contract_version":{"type":"integer","minimum":1},
    "endpoint_class":{"type":"string","enum":["local","service-network","protected","external"]},
    "implementation":{"type":"string","maxLength":200}
  }
}
